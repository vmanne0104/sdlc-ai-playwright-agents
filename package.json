{
  "name": "sdlc-playwright-agents",
  "version": "1.0.0",
  "description": "AI-driven SDLC test automation: Copilot agents + Playwright (UI & API) with HTML reporting",
  "private": true,
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps chromium",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:failed": "playwright test --last-failed",
    "report": "node scripts/open-report.mjs",
    "typecheck": "tsc --noEmit",
    "agents:init": "npx playwright init-agents --loop=vscode"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
